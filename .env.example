# Serigraph inference keys — copy this file to .env and fill in ONE provider.
# .env is gitignored; it never leaves this machine.

# Anthropic (Claude) — used by the AI assistant and the transcript importer
ANTHROPIC_API_KEY=

# OpenAI — used when no Anthropic key is set
OPENAI_API_KEY=

# Optional overrides
# OPENAI_MODEL=gpt-4o
# OPSMAP_MODEL=claude-opus-4-8
# OPSMAP_LLM_CMD=ollama run llama3.1
