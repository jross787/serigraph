# Serigraph inference keys — copy this file to .env and fill in what you use.
# .env is gitignored; it never leaves this machine. You can also set all of
# this in the app under the ••• menu → AI settings.

# Venice.ai — chat (OpenAI-compatible)
VENICE_API_KEY=

# OpenAI — chat and voice transcription
OPENAI_API_KEY=

# OpenRouter — chat and voice transcription (OpenAI-compatible)
OPENROUTER_API_KEY=

# Anthropic (Claude) — chat only; no transcription API
ANTHROPIC_API_KEY=

# Optional: pin a provider or model instead of the automatic choice
# OPSMAP_LLM_PROVIDER=venice            # auto | anthropic | openai | openrouter | venice | cli
# OPSMAP_MODEL=llama-3.3-70b            # chat model
# OPSMAP_VOICE_PROVIDER=api             # browser | api
# OPSMAP_VOICE_MODEL=whisper-1          # transcription model
# OPSMAP_LLM_CMD=ollama run llama3.1    # any local model instead of a key
